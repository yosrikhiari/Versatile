# Versatile Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Then:  docker compose --profile frontend up --build
#
# Name mapping: compose turns JWT_KEY into the backend's Jwt:Key, etc.
# Generate secrets with:  openssl rand -base64 48

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_DB=versatile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Backend: REQUIRED (api fails fast naming the missing var) ─
JWT_KEY=change-this-to-a-strong-random-secret-min-32-chars
JWT_ISSUER=Versatile.Api
JWT_AUDIENCE=Versatile.App
ENCRYPTION_MASTER_KEY=change-this-to-a-strong-random-secret-min-32-chars

# ── Backend: AI providers (optional — features degrade gracefully) ──
# Server-side generation + test-connection use per-user keys stored via the
# API; these env fallbacks apply where the backend needs its own key.
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Resolves inside compose when the ollama profile is active:
#   docker compose --profile ollama up
OLLAMA_BASE_URL=http://ollama:11434

# ── Frontend: CORS origin if the API is reached cross-origin ────
# Not needed for compose (nginx proxies /api + /hubs same-origin).
# Example: Cors__AllowedOrigins__0=https://app.example.com

# ── Chromatic (Visual Regression Testing) ─────────────────────
# CHROMATIC_PROJECT_TOKEN=your-chromatic-project-token
