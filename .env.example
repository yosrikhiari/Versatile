# Versatile Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/versatile?sslmode=disable

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRY_HOURS=720

# ── AI Providers ──────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434

# Mistral AI API key for embeddings (proxied through backend at POST /api/embedding/mistral).
# Set Ai__MistralKey in production environment instead of VITE_ prefix.
# VITE_MISTRAL_API_KEY=mistral-api-key-here

# ── Chromatic (Visual Regression Testing) ──────────────────
# CHROMATIC_PROJECT_TOKEN=your-chromatic-project-token
