{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "100-Chapter Novel Validation Dataset (Fractured Lattice fixture)",
  "description": "Structured fixture fed through the real pipeline modules by scripts/validate-100-chapter.mjs. Regenerated by scripts/build-100-chapter-data.mjs. NOT the canonical Aldric/artifact narrative (that lives in CONSISTENCY_LEDGER.md).",
  "type": "object",
  "required": ["cast", "locations", "threads", "firstSeen", "chapters"],
  "properties": {
    "cast": {
      "type": "array",
      "description": "Character roster. Values are object {id, name}; keys in chapter data reference id (e.g. \"C1\").",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]+$"},
          "name": {"type": "string"}
        }
      }
    },
    "locations": {
      "type": "array",
      "description": "Location roster. Plain id strings (e.g. \"L1\").",
      "items": {"type": "string", "pattern": "^L[0-9]+$"}
    },
    "threads": {
      "type": "array",
      "description": "Plot-thread roster. Plain id strings (e.g. \"T1\").",
      "items": {"type": "string", "pattern": "^T[0-9]+$"}
    },
    "firstSeen": {
      "type": "object",
      "description": "Map entityId -> chapterNumber where the entity first appears.",
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 100}
    },
    "chapters": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapterNumber",
          "title",
          "prose",
          "summary",
          "location",
          "charactersPresent",
          "ending",
          "continuesFrom",
          "scenario",
          "metadataFailed",
          "ingestOrder"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ch-[0-9]{4}$"},
          "chapterNumber": {"type": "integer", "minimum": 1, "maximum": 100},
          "title": {"type": "string"},
          "flashback": {"type": "boolean", "description": "If true, continuesFrom is expected null (no in-world predecessor)."},
          "ending": {"type": "string", "description": "Closing hook; non-empty for every non-flashback chapter (seam continuity)."},
          "continuesFrom": {
            "type": ["string", "null"],
            "description": "id of the preceding chapter for seam continuity. null only for chapter 1 or flashback chapters."
          },
          "prose": {"type": "string"},
          "summary": {"type": "string"},
          "wordCount": {"type": "integer", "minimum": 0},
          "location": {"type": "string", "pattern": "^L[0-9]+$"},
          "charactersPresent": {
            "type": "array",
            "items": {"type": "string", "pattern": "^C[0-9]+$"},
            "description": "Cast ids present in this chapter (drives seam cast carry-over check)."
          },
          "introducedEntities": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Entity ids first introduced in this chapter."
          },
          "keyFacts": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Atomic, checkable facts established in this chapter; may include a travel fact justifying a location change."
          },
          "plotThreadsTouched": {
            "type": "array",
            "items": {"type": "string", "pattern": "^T[0-9]+$"}
          },
          "edges": {
            "type": "array",
            "description": "Relationship assertions as [subjectId, objectId, relation] triples.",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "string"}
            }
          },
          "references": {
            "type": "array",
            "description": "Cross-chapter references; dangling `to` is a referential-violation seed.",
            "items": {
              "type": "object",
              "required": ["to", "kind"],
              "properties": {
                "to": {"type": "string"},
                "kind": {"type": "string"},
                "note": {"type": "string"}
              }
            }
          },
          "negations": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Facts negated in this chapter (contradiction tracking)."
          },
          "scenario": {
            "type": ["string", "null"],
            "description": "Injected inconsistency scenario id, or null for clean/baseline chapters."
          },
          "metadataFailed": {
            "type": "boolean",
            "description": "true if this chapter's metadata extraction was forced to fail (tests fallback)."
          },
          "ingestOrder": {
            "type": "integer",
            "minimum": 1,
            "description": "Order in which the chapter was ingested during the validation run."
          }
        }
      }
    }
  }
}
