# Reference docs, planning, status, workflows (local dev artifacts)
# NOTE: anchored with a leading slash so it never matches .github/workflows —
# a bare `workflows/` pattern silently untracked backend-ci.yml, chromatic.yml
# and eval-regression.yml, meaning backend CI never ran on GitHub.
planning/
reference/
status/
/workflows/
# Chromatic stays untracked until CHROMATIC_PROJECT_TOKEN exists: its workflow
# has no missing-secret guard and would red-flag every UI PR without it.
.github/workflows/chromatic.yml
