{
  "name": "versatile",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{js,ts,vue}",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:fix": "eslint src/**/*.{js,ts,vue} --fix",
    "validate:env": "node scripts/validate-env.mjs",
    "plop": "plop --plopfile plopfile.cjs",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "verify:planning": "npx vite-node scripts/verify-planning-fix.mjs",
    "verify:network": "npx vite-node scripts/verify-network-fix.mjs",
    "verify:cast": "npx vite-node scripts/verify-cast-expansion.mjs",
    "verify:titles": "npx vite-node scripts/verify-title-variety.mjs",
    "audit:manuscript": "node scripts/audit-manuscript.mjs",
    "eval:snapshot": "npx vite-node tools/eval-snapshot.mjs",
    "eval:rag": "npx vite-node scripts/evaluate-rag.js",
    "eval:scene": "npx vite-node scripts/evaluate-scene-retrieval.js",
    "pipeline:quality": "npx vite-node scripts/ml-pipelines/quality-regression/evaluate.js",
    "pipeline:benchmark": "npx vite-node scripts/ml-pipelines/model-benchmarking/evaluate.js",
    "pipeline:active": "npx vite-node scripts/ml-pipelines/active-learning/analyze.js",
    "pipeline:active:sample": "npx vite-node scripts/ml-pipelines/active-learning/analyze.js --source scripts/ml-pipelines/active-learning/sample-eval-history.json",
    "pipeline:curate": "npx vite-node scripts/ml-pipelines/fine-tuning-curation/curate.js",
    "pipeline:curate:sample": "npx vite-node scripts/ml-pipelines/fine-tuning-curation/curate.js --source scripts/ml-pipelines/active-learning/sample-eval-history.json",
    "pipeline:curate:export": "npx vite-node scripts/ml-pipelines/fine-tuning-curation/export-training-set.js",
    "pipeline:curate:train": "npx vite-node scripts/ml-pipelines/fine-tuning-curation/export-training-set.js --source scripts/ml-pipelines/active-learning/sample-eval-history.json",
    "pipeline:drift": "npx vite-node scripts/ml-pipelines/drift-monitor/monitor.js",
    "pipeline:drift:sample": "npx vite-node scripts/ml-pipelines/drift-monitor/monitor.js --source scripts/ml-pipelines/active-learning/sample-eval-history.json",
    "pipeline:drift:synthetic": "npx vite-node scripts/ml-pipelines/drift-monitor/monitor.js --source scripts/ml-pipelines/drift-monitor/sample-drift-evals.json --threshold 1",
    "pipeline:drift:edge": "npx vite-node scripts/ml-pipelines/drift-monitor/monitor.js --source scripts/ml-pipelines/drift-monitor/sample-drift-edge-evals.json --threshold 1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.4.0",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.15",
    "focus-trap": "^8.2.1",
    "gpt-tokenizer": "^3.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-vue-next": "^1.0.0",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^4.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuedraggable": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,vue,css}": "prettier --write",
    "*.{js,vue}": "eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-onboarding": "^10.5.4",
    "@storybook/vue3-vite": "^10.5.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.0",
    "chromatic": "^18.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "playwright": "^1.59.1",
    "plop": "^4.0.5",
    "postcss": "^8.4.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.5.4",
    "tailwindcss": "^3.4.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
